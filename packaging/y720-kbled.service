[Unit]
Description=Lenovo Y720 keyboard backlight
After=systemd-udevd.service systemd-sysusers.service
Wants=systemd-udevd.service

[Service]
Type=simple
User=y720
Group=y720
ExecStart=/usr/bin/y720-kbled daemon
Restart=on-failure
RestartSec=2
StateDirectory=y720-kbled
StateDirectoryMode=0750
RuntimeDirectory=y720-kbled
RuntimeDirectoryMode=0755
UMask=0022

[Install]
WantedBy=multi-user.target
