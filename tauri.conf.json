{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Y720 Keyboard LEDs",
  "version": "0.1.0",
  "identifier": "dev.y720.kbled",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Y720 Keyboard LEDs",
        "width": 1100,
        "height": 700,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "backgroundColor": "#1c1c1c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
